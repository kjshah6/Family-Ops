# Postgres connection strings (Neon gives you these; `neon env pull` writes both)
# Pooled - used by the app at runtime
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Unpooled/direct - used by Prisma Migrate (see schema.prisma `directUrl`)
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Comma-separated list of parent emails allowed to sign in
ALLOWED_PARENT_EMAILS="parent1@example.com,parent2@example.com"

# Resend (free tier) - sends the sign-in link emails
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Passkey relying party ID - your production domain, no protocol, no path
PASSKEY_RP_ID="your-app.vercel.app"

# better-auth
BETTER_AUTH_SECRET="generate-a-random-32-char-string"
BETTER_AUTH_URL="https://your-app.vercel.app"
